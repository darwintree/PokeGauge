{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pokegauge",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-26",
  "assets": {
    // `vite build` emits the client straight into ./dist; the Cloudflare Vite
    // plugin is only active for `vite dev` so the deployed asset root stays here.
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/events", "/api/smogon/*", "/api/pikalytics/*"]
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "pokegauge_events"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
